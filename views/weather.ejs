<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather Search</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="page-container">
        <div class="mini-tag">Live weather</div>
        <h1>Find your city.</h1>
        <p class="search-caption">Check the current weather and stay one step ahead of the day.</p>
        <form action="/weather" method="post">
            <div class="form-group">
                <label for="city">City Name</label>
                <input type="text" id="city" name="city" placeholder="Enter a city like Delhi or Mumbai" required>
                <button type="submit">Get weather</button>
            </div>
        </form>
    </div>
</body>
</html>